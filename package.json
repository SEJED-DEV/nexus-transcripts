  "author": "Sejed TRABELSSI (Cortex HQ)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SEJED-DEV/nexus-transcripts.git"
  },
  "bugs": {
    "url": "https://github.com/SEJED-DEV/nexus-transcripts/issues"
  },
  "homepage": "https://github.com/SEJED-DEV/nexus-transcripts#readme",
  "license": "MIT",
  "peerDependencies": {
    "discord.js": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
