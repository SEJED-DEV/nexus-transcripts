{
  "name": "nexus-transcripts",
  "version": "1.0.0",
  "description": "Next-gen dynamic and interactive HTML transcripts for Discord channels",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && node build.js",
    "test": "node dist/test/run.js",
    "dev": "tsc -w",
    "start": "node dev-server.js"
  },
  "keywords": [
    "discord",
